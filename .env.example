# নিচের দুটি ফাঁকা রাখা যাবে না, উদাহরণের মানও চলবে না। এলোমেলো মান বানাতে:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_KEY কমপক্ষে ২৪ অক্ষর, SESSION_SECRET কমপক্ষে ৩২ অক্ষর। দুটো আলাদা মান দিন।
ADMIN_KEY=
SESSION_SECRET=
SITE_URL=http://localhost:3000
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=service_role-key-here
# ইমেইল পাঠানোর SMTP (খালি রাখলে লিংক শুধু টার্মিনালে দেখাবে, ইমেইল যাবে না)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
MAIL_FROM=নাগরিক সেবা পোর্টাল <you@gmail.com>
