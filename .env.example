ADMIN_KEY=replace-with-a-random-secret-at-least-32-characters
SESSION_SECRET=replace-with-random-64-hex-characters
SITE_URL=http://localhost:3000 # production: your HTTPS domain
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-server-only-service-role-key
# Browser-safe Supabase Auth credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional transactional email via Resend (only when you configure a verified sender/domain).
# Delivery quotas depend on the provider plan; this is not required for in-app notifications.
RESEND_API_KEY=
EMAIL_FROM=Citizen Portal <noreply@your-verified-domain.example>
